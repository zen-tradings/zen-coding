# zen-coding credentials
# NOT auto-loaded by `npm run agent` / `npm run slack` — see README/session notes
# for how to load this into your shell before running. Already gitignored.

# --- Model provider (need at least ONE) ---
# Repo default provider/model is Fireworks (.pi/settings.json), so that's the
# one to fill in first unless you plan to `/model` to something else.
FIREWORKS_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# --- Optional tools/MCP connectors ---
EXA_API_KEY=
ALPHAXIV_API_KEY=
RENDER_API_KEY=

# --- GitHub (private repo checkouts for Slack backend; GitHub MCP itself
#     reuses `gh auth token` and does not need this) ---
GITHUB_TOKEN=

# --- Self-hosted / local model endpoint (.pi/extensions/zen-models.ts) ---
ZEN_LOCAL_BASE_URL=
ZEN_LOCAL_MODELS=
ZEN_LOCAL_API_KEY=
ZEN_LOCAL_CONTEXT_WINDOW=
ZEN_LOCAL_MAX_TOKENS=

# --- Braintrust tracing (opt-in, off by default) ---
TRACE_TO_BRAINTRUST=false
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=zen-coding

# --- Slack backend (src/slack/) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
ZEN_SLACK_WORKSPACES=
ZEN_SLACK_DEFAULT_CWD=
ZEN_SLACK_MODEL=
ZEN_SLACK_CLONE_DEPTH=
ZEN_SLACK_IDLE_MINUTES=
ZEN_SLACK_ALLOWED_USERS=

# --- wq-alpha-research skill (.pi/skills/wq-alpha-research) ---
# Note: that skill's own scripts also accept an untracked credential.txt
# instead of env vars — see AGENTS.md. Never commit either.
WQ_BRAIN_USERNAME=
WQ_BRAIN_PASSWORD=
