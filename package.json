{
  "name": "zen-coding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quant coding agent built on pi (@earendil-works/pi-coding-agent)",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions"
    ]
  },
  "scripts": {
    "agent": "pi",
    "slack": "tsx src/slack/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@slack/bolt": "^5.0.0",
    "@slack/web-api": "^8.0.0",
    "braintrust": "^3.27.0",
    "minimatch": "^10.2.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.5",
    "typescript": "^5.7.0"
  }
}
