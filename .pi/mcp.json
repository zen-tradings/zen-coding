{
  "mcpServers": {
    "alphaxiv": {
      "url": "https://api.alphaxiv.org/mcp/v1",
      "auth": "bearer",
      "bearerTokenEnv": "ALPHAXIV_API_KEY",
      "requestTimeoutMs": 60000
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": "bearer",
      "bearerToken": "!gh auth token",
      "requestTimeoutMs": 60000
    },
    "paper-search": {
      "command": "uvx",
      "args": ["paper-search-mcp"],
      "requestTimeoutMs": 120000
    },
    "docker": {
      "command": "docker",
      "args": ["mcp", "gateway", "run"],
      "requestTimeoutMs": 120000
    },
    "mintlify-docs": {
      "url": "https://www.mintlify.com/docs/mcp",
      "auth": false,
      "requestTimeoutMs": 60000
    },
    "render": {
      "url": "https://mcp.render.com/mcp",
      "auth": "bearer",
      "bearerTokenEnv": "RENDER_API_KEY",
      "requestTimeoutMs": 60000
    }
  }
}
