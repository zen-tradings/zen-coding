{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Zen Trading Docs",
  "theme": "mint",
  "colors": {
    "primary": "#8FB3D1",
    "light": "#BBD0E3",
    "dark": "#F7F7F4"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#F8FAFC",
      "dark": "#0E1932"
    }
  },
  "logo": {
    "light": "/zen-trading-wordmark-dark.svg",
    "dark": "/zen-trading-wordmark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/zen-tradings"
      }
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": ["index"]
      },
      {
        "group": "Coding Agent",
        "pages": ["install-anywhere", "mcp-connectors", "slack", "evals"]
      },
      {
        "group": "Fundamental Agent",
        "pages": ["fundamental-agent/index"]
      },
      {
        "group": "Benchmarking",
        "pages": [
          "benchmarking/index",
          "benchmarking/quickstart",
          "benchmarking/routers",
          "benchmarking/prompt-set",
          "benchmarking/metrics"
        ]
      },
      {
        "group": "Zen RFT",
        "pages": ["zen-rft/index"]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/zen-tradings"
    }
  }
}
